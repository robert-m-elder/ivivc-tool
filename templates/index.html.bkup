<!DOCTYPE html>
<html>
<head>
    <title>Time Series Correlation App</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <h1>Upload Your Spreadsheet and Select Models</h1>
    <form method="post" enctype="multipart/form-data" id="upload-form">
        <div>
            <label for="file">Upload Spreadsheet:</label>
            <input type="file" name="file" id="file" accept=".xlsx,.xls,.csv" required>
        </div>
        <div>
            <h3>Select Models to Include:</h3>
            {% for model_name, model_info in models.items() %}
            <label>
                <input type="checkbox" name="models" value="{{ model_name }}" checked> 
                {{ model_info.display_name }}
            </label><br>
            {% endfor %}
        </div>
        <div>
            <input type="submit" value="Analyze Data">
        </div>
    </form>

    <script>
        $(document).ready(function() {
            $('#upload-form').on('submit', function(e) {
                var checkedModels = $('input[name="models"]:checked');
                if (checkedModels.length === 0) {
                    e.preventDefault();
                    alert('Please select at least one model for analysis.');
                }
            });
        });
    </script>
</body>
</html>
